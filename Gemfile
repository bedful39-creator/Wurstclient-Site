source "https://rubygems.org"

# Plain Jekyll build plus the plugins this site uses. The GitHub Pages gem
# bundle is not used here because Vercel's build image runs a much smaller
# Ruby environment; the output is equivalent.
gem "jekyll", "~> 4.3"
gem "kramdown-parser-gfm"

group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-feed"
  gem "jekyll-redirect-from"
end
